# Where the back office publishes content. The site reads /api/marketing/content there.
CONTENT_URL=https://dashboard.zogal.app
# Where "Get the app" and "Start free" go.
NEXT_PUBLIC_APP_URL=https://dashboard.zogal.app
# The same value as the back office's "site key" (Marketing -> Site & settings).
# The back office sends it as the x-zogal-key header when it asks us to refresh.
MARKETING_REVALIDATE_SECRET=
